{
  "stack_name": "Conxian",
  "version": "1.0.0",
  "layers": [
    {
      "id": "protocol-core",
      "name": "lib-conxian-core",
      "role": "Canonical protocol primitives, invariants, and control contracts",
      "visibility": "Public",
      "ownership": "Protocol Team",
      "trust_boundary": "L0 (Root of Trust)",
      "contracts": [
        "ControlModel",
        "Invariant validation",
        "BIP-110 preflight contracts",
        "Platform-neutral adapter interfaces"
      ],
      "repository": "https://github.com/Conxian/lib-conxian-core"
    },
    {
      "id": "enclave-sdk",
      "name": "conxius-enclave-sdk",
      "role": "Production hardware-backed signing, attestation, and policy flows",
      "visibility": "Public",
      "ownership": "Security Team",
      "trust_boundary": "L1 (Hardware Isolated)",
      "dependencies": ["protocol-core"],
      "repository": "https://github.com/Conxian/conxius-enclave-sdk"
    },
    {
      "id": "enclave-adapter",
      "name": "lib-conxian-core-enclave",
      "role": "Narrow Core/SDK compatibility adapter and fail-closed contract boundary",
      "visibility": "Public",
      "ownership": "Protocol/Security Integration",
      "trust_boundary": "L1 (Contract Boundary)",
      "dependencies": ["protocol-core", "enclave-sdk"],
      "repository": "https://github.com/Conxian/lib-conxian-core"
    },
    {
      "id": "gateway",
      "name": "conxian-gateway",
      "role": "Runtime orchestration and protocol routing",
      "visibility": "Public",
      "ownership": "Infrastructure Team",
      "trust_boundary": "L2 (Network Orchestration)",
      "dependencies": ["protocol-core"],
      "repository": "https://github.com/Conxian/conxian-gateway"
    },
    {
      "id": "nexus",
      "name": "conxian-nexus",
      "role": "State settlement and ecosystem coordination",
      "visibility": "Public",
      "ownership": "Protocol Team",
      "trust_boundary": "L1 (State Finality)",
      "repository": "https://github.com/Conxian/conxian-nexus"
    },
    {
      "id": "wallet",
      "name": "conxius-wallet",
      "role": "Non-custodial user interface for signing and assets",
      "visibility": "Public",
      "ownership": "Product Team",
      "trust_boundary": "L3 (User Managed)",
      "dependencies": ["enclave-adapter", "protocol-core"],
      "repository": "https://github.com/Conxian/conxius-wallet"
    },
    {
      "id": "ui",
      "name": "conxian_ui",
      "role": "Product dashboard and DeFi interface",
      "visibility": "Public",
      "ownership": "Product Team",
      "trust_boundary": "L3 (User Managed)",
      "dependencies": ["gateway"],
      "repository": "https://github.com/Conxian/conxian_ui"
    }
  ],
  "integration_contracts": {
    "signing": "conxius-enclave-sdk production signing through the lib-conxian-core-enclave compatibility boundary",
    "routing": "Gateway MCP/REST API for protocol adapters",
    "settlement": "Nexus state proposals and anchors"
  }
}
