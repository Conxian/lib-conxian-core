{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EC2Permissions",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateKeyPair"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IAMInstanceProfilePermission",
      "Effect": "Allow",
      "Action": "iam:CreateInstanceProfile",
      "Resource": "*"
    },
    {
      "Sid": "IAMPassRolePermission",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::692112933743:role/conxian-nitro-enclave-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    }
  ]
}
